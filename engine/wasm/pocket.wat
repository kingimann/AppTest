;; Pocket Engine's WebAssembly helpers: grid A* pathfinding and voxel chunk meshing.
;; Memory: bytes 0..383 hold the 6 voxel faces (written by JS); JS places everything else from byte 1024.
(module
  (memory (export "mem") 1)
  (global $hp (mut i32) (i32.const 0))
  (global $hn (mut i32) (i32.const 0))

  ;; ---- binary min-heap of (f32 cost, i32 cell), 8 bytes each ----
  (func $push (param $f f32) (param $id i32)
    (local $i i32) (local $p i32) (local $pa i32) (local $ia i32)
    (local.set $i (global.get $hn))
    (global.set $hn (i32.add (global.get $hn) (i32.const 1)))
    (block $done
      (loop $up
        (br_if $done (i32.eqz (local.get $i)))
        (local.set $p (i32.shr_u (i32.sub (local.get $i) (i32.const 1)) (i32.const 1)))
        (local.set $pa (i32.add (global.get $hp) (i32.shl (local.get $p) (i32.const 3))))
        (br_if $done (f32.le (f32.load (local.get $pa)) (local.get $f)))
        (i64.store (i32.add (global.get $hp) (i32.shl (local.get $i) (i32.const 3))) (i64.load (local.get $pa)))
        (local.set $i (local.get $p))
        (br $up)))
    (local.set $ia (i32.add (global.get $hp) (i32.shl (local.get $i) (i32.const 3))))
    (f32.store (local.get $ia) (local.get $f))
    (i32.store offset=4 (local.get $ia) (local.get $id)))

  (func $pop (result i32)
    (local $top i32) (local $n i32) (local $i i32) (local $c i32) (local $lf f32) (local $last i64) (local $ca i32)
    (local.set $top (i32.load offset=4 (global.get $hp)))
    (global.set $hn (i32.sub (global.get $hn) (i32.const 1)))
    (local.set $n (global.get $hn))
    (local.set $last (i64.load (i32.add (global.get $hp) (i32.shl (local.get $n) (i32.const 3)))))
    (local.set $lf (f32.load (i32.add (global.get $hp) (i32.shl (local.get $n) (i32.const 3)))))
    (block $done
      (loop $down
        (local.set $c (i32.add (i32.shl (local.get $i) (i32.const 1)) (i32.const 1)))
        (br_if $done (i32.ge_u (local.get $c) (local.get $n)))
        (if (i32.lt_u (i32.add (local.get $c) (i32.const 1)) (local.get $n))
          (then (if (f32.lt (f32.load (i32.add (global.get $hp) (i32.shl (i32.add (local.get $c) (i32.const 1)) (i32.const 3))))
                            (f32.load (i32.add (global.get $hp) (i32.shl (local.get $c) (i32.const 3)))))
                  (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))))
        (local.set $ca (i32.add (global.get $hp) (i32.shl (local.get $c) (i32.const 3))))
        (br_if $done (f32.ge (f32.load (local.get $ca)) (local.get $lf)))
        (i64.store (i32.add (global.get $hp) (i32.shl (local.get $i) (i32.const 3))) (i64.load (local.get $ca)))
        (local.set $i (local.get $c))
        (br $down)))
    (i64.store (i32.add (global.get $hp) (i32.shl (local.get $i) (i32.const 3))) (local.get $last))
    (local.get $top))

  ;; A* on a W×H grid, 8 directions, no corner cutting. blocked: u8[N] at $oB; scratch g f32[N] $oG, came i32[N] $oC,
  ;; closed u8[N] $oX, heap at $oH (8·8·N bytes). Writes the path (cell indices, start → target) at $oO; returns its length (0 = none).
  (func (export "astar") (param $W i32) (param $H i32) (param $s i32) (param $t i32)
        (param $oB i32) (param $oG i32) (param $oC i32) (param $oX i32) (param $oH i32) (param $oO i32) (result i32)
    (local $N i32) (local $k i32) (local $id i32) (local $i i32) (local $j i32) (local $ti f32) (local $tj f32)
    (local $di i32) (local $dj i32) (local $ni i32) (local $nj i32) (local $nid i32) (local $ng f32) (local $len i32) (local $c i32)
    (local.set $N (i32.mul (local.get $W) (local.get $H)))
    (local.set $k (i32.const 0))
    (block $e (loop $l
      (br_if $e (i32.ge_u (local.get $k) (local.get $N)))
      (f32.store (i32.add (local.get $oG) (i32.shl (local.get $k) (i32.const 2))) (f32.const inf))
      (i32.store (i32.add (local.get $oC) (i32.shl (local.get $k) (i32.const 2))) (i32.const -1))
      (i32.store8 (i32.add (local.get $oX) (local.get $k)) (i32.const 0))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l)))
    (global.set $hp (local.get $oH)) (global.set $hn (i32.const 0))
    (local.set $ti (f32.convert_i32_u (i32.rem_u (local.get $t) (local.get $W))))
    (local.set $tj (f32.convert_i32_u (i32.div_u (local.get $t) (local.get $W))))
    (f32.store (i32.add (local.get $oG) (i32.shl (local.get $s) (i32.const 2))) (f32.const 0))
    (call $push (f32.const 0) (local.get $s))
    (block $fail (loop $search
      (br_if $fail (i32.eqz (global.get $hn)))
      (local.set $id (call $pop))
      (br_if $search (i32.load8_u (i32.add (local.get $oX) (local.get $id))))
      (i32.store8 (i32.add (local.get $oX) (local.get $id)) (i32.const 1))
      (if (i32.eq (local.get $id) (local.get $t)) (then
        ;; count, then write the path backwards
        (local.set $c (local.get $t)) (local.set $len (i32.const 0))
        (block $e2 (loop $l2 (br_if $e2 (i32.eq (local.get $c) (i32.const -1)))
          (local.set $len (i32.add (local.get $len) (i32.const 1)))
          (local.set $c (i32.load (i32.add (local.get $oC) (i32.shl (local.get $c) (i32.const 2))))) (br $l2)))
        (local.set $c (local.get $t)) (local.set $k (local.get $len))
        (block $e3 (loop $l3 (br_if $e3 (i32.eq (local.get $c) (i32.const -1)))
          (local.set $k (i32.sub (local.get $k) (i32.const 1)))
          (i32.store (i32.add (local.get $oO) (i32.shl (local.get $k) (i32.const 2))) (local.get $c))
          (local.set $c (i32.load (i32.add (local.get $oC) (i32.shl (local.get $c) (i32.const 2))))) (br $l3)))
        (return (local.get $len))))
      (local.set $i (i32.rem_u (local.get $id) (local.get $W)))
      (local.set $j (i32.div_u (local.get $id) (local.get $W)))
      (local.set $dj (i32.const -1))
      (loop $ly
        (local.set $di (i32.const -1))
        (loop $lx
          (block $next
            (br_if $next (i32.and (i32.eqz (local.get $di)) (i32.eqz (local.get $dj))))
            (local.set $ni (i32.add (local.get $i) (local.get $di)))
            (local.set $nj (i32.add (local.get $j) (local.get $dj)))
            (br_if $next (i32.lt_s (local.get $ni) (i32.const 0)))
            (br_if $next (i32.lt_s (local.get $nj) (i32.const 0)))
            (br_if $next (i32.ge_s (local.get $ni) (local.get $W)))
            (br_if $next (i32.ge_s (local.get $nj) (local.get $H)))
            (local.set $nid (i32.add (i32.mul (local.get $nj) (local.get $W)) (local.get $ni)))
            (br_if $next (i32.load8_u (i32.add (local.get $oB) (local.get $nid))))
            (br_if $next (i32.load8_u (i32.add (local.get $oX) (local.get $nid))))
            (if (i32.and (i32.ne (local.get $di) (i32.const 0)) (i32.ne (local.get $dj) (i32.const 0))) (then ;; no cutting corners
              (br_if $next (i32.load8_u (i32.add (local.get $oB) (i32.add (i32.mul (local.get $j) (local.get $W)) (local.get $ni)))))
              (br_if $next (i32.load8_u (i32.add (local.get $oB) (i32.add (i32.mul (local.get $nj) (local.get $W)) (local.get $i)))))))
            (local.set $ng (f32.add (f32.load (i32.add (local.get $oG) (i32.shl (local.get $id) (i32.const 2))))
              (select (f32.const 1.414) (f32.const 1) (i32.and (i32.ne (local.get $di) (i32.const 0)) (i32.ne (local.get $dj) (i32.const 0))))))
            (br_if $next (f32.ge (local.get $ng) (f32.load (i32.add (local.get $oG) (i32.shl (local.get $nid) (i32.const 2))))))
            (f32.store (i32.add (local.get $oG) (i32.shl (local.get $nid) (i32.const 2))) (local.get $ng))
            (i32.store (i32.add (local.get $oC) (i32.shl (local.get $nid) (i32.const 2))) (local.get $id))
            (call $push (f32.add (local.get $ng)
              (f32.sqrt (f32.add
                (f32.mul (f32.sub (f32.convert_i32_s (local.get $ni)) (local.get $ti)) (f32.sub (f32.convert_i32_s (local.get $ni)) (local.get $ti)))
                (f32.mul (f32.sub (f32.convert_i32_s (local.get $nj)) (local.get $tj)) (f32.sub (f32.convert_i32_s (local.get $nj)) (local.get $tj))))))
              (local.get $nid)))
          (local.set $di (i32.add (local.get $di) (i32.const 1)))
          (br_if $lx (i32.le_s (local.get $di) (i32.const 1))))
        (local.set $dj (i32.add (local.get $dj) (i32.const 1)))
        (br_if $ly (i32.le_s (local.get $dj) (i32.const 1))))
      (br $search)))
    (i32.const 0))

  ;; The same per-block brightness jitter as the JS mesher (0.94 – 1.04).
  (func $jit (param $i i32) (param $j i32) (param $k i32) (result f32)
    (local $h i32)
    (local.set $h (i32.xor (i32.xor (i32.mul (local.get $i) (i32.const 73856093)) (i32.mul (local.get $j) (i32.const 19349663))) (i32.mul (local.get $k) (i32.const 83492791))))
    (local.set $h (i32.mul (i32.xor (local.get $h) (i32.shr_u (local.get $h) (i32.const 13))) (i32.const 1274126177)))
    (f32.add (f32.const 0.94) (f32.mul (f32.convert_i32_u (i32.and (local.get $h) (i32.const 65535))) (f32.const 0.00000152587890625))))

  ;; Mesh one chunk. vol: u8 blocks at $oV, padded by one on every side, index ((x·Z2)+z)·Y2+y with x,z in 0..cw+1 and y in 0..ny+1.
  ;; Palette: nc RGB f32 triples at $oP. Writes 9 floats per vertex (position, normal, colour) at $oO; returns the float count.
  (func (export "mesh") (param $oV i32) (param $cw i32) (param $ny i32) (param $i0 i32) (param $j0 i32) (param $k0 i32)
        (param $s f32) (param $oP i32) (param $nc i32) (param $oO i32) (result i32)
    (local $Y2 i32) (local $Z2 i32) (local $x i32) (local $z i32) (local $y i32) (local $idx i32) (local $c i32)
    (local $bi i32) (local $bj i32) (local $bk i32) (local $jt f32) (local $f i32) (local $fa i32) (local $col i32)
    (local $r f32) (local $g f32) (local $b f32) (local $sh f32) (local $o i32) (local $v i32) (local $va i32) (local $vi i32)
    (local.set $Y2 (i32.add (local.get $ny) (i32.const 2)))
    (local.set $Z2 (i32.add (local.get $cw) (i32.const 2)))
    (local.set $o (local.get $oO))
    (local.set $x (i32.const 1))
    (loop $lx
      (local.set $z (i32.const 1))
      (loop $lz
        (local.set $y (i32.const 1))
        (loop $ly
          (local.set $idx (i32.add (i32.mul (i32.add (i32.mul (local.get $x) (local.get $Z2)) (local.get $z)) (local.get $Y2)) (local.get $y)))
          (local.set $c (i32.load8_u (i32.add (local.get $oV) (local.get $idx))))
          (if (local.get $c) (then
            (local.set $bi (i32.add (local.get $i0) (i32.sub (local.get $x) (i32.const 1))))
            (local.set $bj (i32.add (local.get $j0) (i32.sub (local.get $y) (i32.const 1))))
            (local.set $bk (i32.add (local.get $k0) (i32.sub (local.get $z) (i32.const 1))))
            (local.set $jt (call $jit (local.get $bi) (local.get $bj) (local.get $bk)))
            (local.set $f (i32.const 0))
            (loop $lf
              ;; face record: nx ny nz shade, 4 corners × xyz (f32), 64 bytes at f·64
              (local.set $fa (i32.shl (local.get $f) (i32.const 6)))
              (block $skip
                (br_if $skip (i32.load8_u (i32.add (local.get $oV) (i32.add (local.get $idx) (i32.add (i32.add
                  (i32.mul (i32.trunc_f32_s (f32.load (local.get $fa))) (i32.mul (local.get $Z2) (local.get $Y2)))
                  (i32.mul (i32.trunc_f32_s (f32.load offset=8 (local.get $fa))) (local.get $Y2)))
                  (i32.trunc_f32_s (f32.load offset=4 (local.get $fa))))))))
                ;; grass blocks (colour 1) have dirt sides (colour 2)
                (local.set $col (i32.rem_u (i32.sub (local.get $c) (i32.const 1)) (local.get $nc)))
                (if (i32.and (i32.and (i32.eq (local.get $c) (i32.const 1)) (f32.ne (f32.load offset=4 (local.get $fa)) (f32.const 1))) (i32.gt_u (local.get $nc) (i32.const 1)))
                  (then (local.set $col (i32.const 1))))
                (local.set $col (i32.add (local.get $oP) (i32.mul (local.get $col) (i32.const 12))))
                (local.set $sh (f32.mul (local.get $jt) (f32.load offset=12 (local.get $fa))))
                (local.set $r (f32.mul (f32.load (local.get $col)) (local.get $sh)))
                (local.set $g (f32.mul (f32.load offset=4 (local.get $col)) (local.get $sh)))
                (local.set $b (f32.mul (f32.load offset=8 (local.get $col)) (local.get $sh)))
                ;; two triangles: corners 0 1 2 0 2 3
                (local.set $vi (i32.const 0))
                (loop $lv
                  (local.set $v (select (i32.const 0) (select (local.get $vi) (i32.sub (local.get $vi) (i32.const 2)) (i32.lt_u (local.get $vi) (i32.const 3)))
                    (i32.eq (local.get $vi) (i32.const 3))))
                  (if (i32.eq (local.get $vi) (i32.const 4)) (then (local.set $v (i32.const 2))))
                  (if (i32.eq (local.get $vi) (i32.const 5)) (then (local.set $v (i32.const 3))))
                  (local.set $va (i32.add (i32.add (local.get $fa) (i32.const 16)) (i32.mul (local.get $v) (i32.const 12))))
                  (f32.store (local.get $o) (f32.mul (f32.add (f32.convert_i32_s (local.get $bi)) (f32.load (local.get $va))) (local.get $s)))
                  (f32.store offset=4 (local.get $o) (f32.mul (f32.add (f32.convert_i32_s (local.get $bj)) (f32.load offset=4 (local.get $va))) (local.get $s)))
                  (f32.store offset=8 (local.get $o) (f32.mul (f32.add (f32.convert_i32_s (local.get $bk)) (f32.load offset=8 (local.get $va))) (local.get $s)))
                  (f32.store offset=12 (local.get $o) (f32.load (local.get $fa)))
                  (f32.store offset=16 (local.get $o) (f32.load offset=4 (local.get $fa)))
                  (f32.store offset=20 (local.get $o) (f32.load offset=8 (local.get $fa)))
                  (f32.store offset=24 (local.get $o) (local.get $r))
                  (f32.store offset=28 (local.get $o) (local.get $g))
                  (f32.store offset=32 (local.get $o) (local.get $b))
                  (local.set $o (i32.add (local.get $o) (i32.const 36)))
                  (local.set $vi (i32.add (local.get $vi) (i32.const 1)))
                  (br_if $lv (i32.lt_u (local.get $vi) (i32.const 6)))))
              (local.set $f (i32.add (local.get $f) (i32.const 1)))
              (br_if $lf (i32.lt_u (local.get $f) (i32.const 6))))))
          (local.set $y (i32.add (local.get $y) (i32.const 1)))
          (br_if $ly (i32.le_u (local.get $y) (local.get $ny))))
        (local.set $z (i32.add (local.get $z) (i32.const 1)))
        (br_if $lz (i32.le_u (local.get $z) (local.get $cw))))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br_if $lx (i32.le_u (local.get $x) (local.get $cw))))
    (i32.shr_u (i32.sub (local.get $o) (local.get $oO)) (i32.const 2))))
